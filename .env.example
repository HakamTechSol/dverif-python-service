PORT=5001
# Bind to loopback by default. Set HOST=0.0.0.0 ONLY for a real deployment
# (e.g. a reverse proxy / another machine) — never for local dev.
HOST=127.0.0.1
DOC_SERVICE_API_KEY=replace-with-a-long-random-string
# Per-file upload cap in MB. Slightly above the Node backend's 10MB multer cap
# so legitimate forwarded files are never rejected.
MAX_UPLOAD_SIZE_MB=15

# --- Laya decision engine (advisory; see app/services/laya_engine.py) -------
# OFF by default. Two measured reasons to leave it off unless you have a host
# that can absorb it: the first checkpoint build took 60-124s and a warm
# inference ran 1.7-35s on CPU, and it downloads ~0.6-0.8GB of weights. While
# off, /ocr/extract costs nothing and reports no laya block beyond a stub.
#
# Its answers are also advisory: only document_type is calibrated for HR
# documents. document_risk and is_official_document are NOT safe to gate on.
LAYA_ENABLED=false

# Resident checkpoints. Measured on a 4-core CPU box:
#   LAYA_MAX_LOADED=1 (+ no preload) -> 187MB RSS idle
#   LAYA_PRELOAD=true                -> 6.3GB committed, ~281s blocking startup
# 1 is the only value consistent with "no memory spike". Each extra resident
# checkpoint is roughly another 0.8GB.
LAYA_MAX_LOADED=1

# Preload every checkpoint at startup. Off by default: it blocks boot for
# minutes and needs a 2.26GB download. Only enable on a host with RAM to spare
# where a slow first request would be worse than a slow start.
LAYA_PRELOAD=false

# "cpu" is the default (no GPU contract in this service; laya silently falls
# back to CPU anyway). LAYA_DEVICE=cuda is a preference, not a promise.
LAYA_DEVICE=cpu

# Characters of OCR text handed to the model (~1500 tokens). Cost on CPU is
# linear in tokens and a dense page carries far more text than a decision model
# benefits from.
LAYA_MAX_CHARS=6000

# Concurrent inferences. 1 serialises them, because torch already uses several
# intra-op threads per forward pass and overlapping requests only oversubscribe
# the cores.
LAYA_MAX_CONCURRENCY=1

# Wall-clock ceiling for one inference, enforced in-process. Bounds the WAIT,
# not the work: a thread inside torch cannot be cancelled, and the checkpoint it
# was building stays cached so the next call is warm. 30s covers the measured
# warm range; it will NOT cover a 60-124s first build, which therefore times out
# and succeeds on a later call. The engine fails open either way, so hitting this
# only costs the advisory block.
LAYA_TIMEOUT_S=30

# torch.set_num_threads is process-global and also affects OCR. 0 leaves torch's
# default alone, which is correct: measured 1/2/4 threads moved latency by 10x in
# both directions on this host and the cause was contention, not the setting.
LAYA_TORCH_THREADS=0