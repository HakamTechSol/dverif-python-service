PORT=5001
# Bind to loopback by default. Set HOST=0.0.0.0 ONLY for a real deployment
# (e.g. a reverse proxy / another machine) — never for local dev.
HOST=127.0.0.1
DOC_SERVICE_API_KEY=replace-with-a-long-random-string
# Per-file upload cap in MB. Slightly above the Node backend's 10MB multer cap
# so legitimate forwarded files are never rejected.
MAX_UPLOAD_SIZE_MB=15